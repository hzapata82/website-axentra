# WordPress Headless CMS (GraphQL)
WORDPRESS_API_URL=https://cms.axentra.com/graphql
WORDPRESS_PREVIEW_SECRET=your-preview-secret-here
WORDPRESS_GRAPHQL_AUTH_REFRESH_TOKEN=your-refresh-token-here

# Vercel Deployment
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/xxx
NEXT_PUBLIC_SITE_URL=https://axentra.com

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Feature Flags
NEXT_PUBLIC_ENABLE_DARK_MODE=true
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Development
NODE_ENV=development