# Web3Forms — https://web3forms.com (free tier: 250 submissions/month)
# Sign up with ventas@axentracargo.com, get an access_key, paste below.
# This key is public (used in browser) — that's the design of Web3Forms.
NEXT_PUBLIC_WEB3FORMS_KEY=your-access-key-here

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Site
NEXT_PUBLIC_SITE_URL=https://axentracargo.com

# Development
NODE_ENV=development